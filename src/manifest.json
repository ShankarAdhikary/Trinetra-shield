{
  "manifest_version": 3,
  "name": "TRINETRA - Safe & Productive Browsing",
  "version": "1.0.0",
  "description": "Your Third Eye for Safe and Productive Browsing - Phishing protection, task management, time tracking, and smart notifications.",
  "author": "TRINETRA Team",
  
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "TRINETRA"
  },
  
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_start"
    }
  ],
  
  "options_page": "options/options.html",
  
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "tabs",
    "activeTab",
    "identity",
    "webNavigation"
  ],
  
  "host_permissions": [
    "https://safebrowsing.googleapis.com/*",
    "https://api.trinetra.app/*",
    "http://localhost:3000/*",
    "https://trinetra-shield.onrender.com/*",
    "<all_urls>"
  ],
  
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "content/blocked.html",
        "auth/login.html",
        "auth/login.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  
  "oauth2": {
    "client_id": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  
  "minimum_chrome_version": "110",
  
  "offline_enabled": true
}
