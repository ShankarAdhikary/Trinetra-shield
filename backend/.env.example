# TRINETRA Backend Environment Configuration
# Copy this file to .env and fill in your values

# ================================
# REQUIRED
# ================================

# Server Configuration
NODE_ENV=production
PORT=3000

# JWT Configuration (REQUIRED - generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ================================
# CORS Configuration
# ================================
ALLOWED_ORIGINS=chrome-extension://your-extension-id,https://trinetra-shield.onrender.com

# App URL (for email links)
APP_URL=https://trinetra-shield.onrender.com

# ================================
# SMS PROVIDERS (Choose One for Real OTP)
# ================================

# Option 1: Twilio (Global, $0.0075/SMS)
# Sign up: https://www.twilio.com
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# Option 2: MSG91 (India, cheaper for Indian numbers)
# Sign up: https://msg91.com
# MSG91_AUTH_KEY=your-auth-key
# MSG91_TEMPLATE_ID=your-template-id

# Option 3: TextLocal (UK/India)
# Sign up: https://www.textlocal.in
# TEXTLOCAL_API_KEY=your-api-key

# ================================
# EMAIL (Gmail SMTP - FREE)
# ================================
# Enable 2FA and create App Password:
# Google Account → Security → 2-Step Verification → App passwords
# EMAIL_USER=your.email@gmail.com
# EMAIL_APP_PASSWORD=your-16-char-app-password

# ================================
# CAPTCHA - Cloudflare Turnstile (FREE FOREVER)
# ================================
# Sign up: https://dash.cloudflare.com → Turnstile
# TURNSTILE_SITE_KEY=your-site-key
# TURNSTILE_SECRET_KEY=your-secret-key

# ================================
# Google OAuth (for Google Sign-In)
# ================================
# Google Cloud Console: https://console.cloud.google.com
# Create OAuth 2.0 Client ID for Chrome Extension
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Safe Browsing API (optional, for enhanced security checks)
# GOOGLE_SAFE_BROWSING_API_KEY=your-safe-browsing-api-key

# ================================
# Firebase (optional, for persistent storage)
# ================================
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=your-firebase-client-email
# FIREBASE_PRIVATE_KEY="your-firebase-private-key"

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# Logging
# ================================
LOG_LEVEL=info
